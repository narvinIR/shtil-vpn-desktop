{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ShtilVPN",
  "version": "1.3.7",
  "identifier": "app.realityvpn.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:6221",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Штиль VPN",
        "width": 1024,
        "height": 700,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp":"default-src 'self' asset: data: blob:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": [
      "msi",
      "nsis",
      "deb",
      "rpm",
      "appimage",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://sub.ndvsdom54.ru/desktop/version?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwMTc2MjFFNThEMUE5QgpSV1NiR28zbElYWUJET2VVZzdBRE9LMnQvU2FDN3VZM0tYRlg3OTh5cGx1QVZRQ1BMR1dTU3Avbgo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}